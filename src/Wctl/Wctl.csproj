<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>w</AssemblyName>
    <RootNamespace>Wctl</RootNamespace>
    <Version>0.1.0</Version>
    <Product>wctl</Product>
    <Description>Fast commands for controlling Windows.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- One native exe, no runtime to install, fast startup. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StackTraceSupport>true</StackTraceSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wctl.Tests" />
  </ItemGroup>

</Project>
