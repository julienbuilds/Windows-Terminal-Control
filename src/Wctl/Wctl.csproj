<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>w</AssemblyName>
    <RootNamespace>Wctl</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Windows Terminal Control</Product>
    <Authors>Julien Schweter</Authors>
    <Description>Fast commands for controlling Windows. Apps, windows, audio, displays and power from one short command.</Description>
    <RepositoryUrl>https://github.com/julienbuilds/Windows-Terminal-Control</RepositoryUrl>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Required by source generated COM interop (Platform/Windows). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- One native exe, no runtime to install, fast startup. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StackTraceSupport>true</StackTraceSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wctl.Tests" />
  </ItemGroup>

</Project>
